# --- LLM ---------------------------------------------------------------
# Leave unset to run in deterministic mock mode (no key required).
OPENAI_API_KEY=
# gpt-4o-mini | gpt-4o | gpt-4.1 | gpt-4.1-mini | ... (see backend/app/config.py pricing table)
GRAPHAGENT_MODEL=gpt-4o-mini
# Force mock (1) or force openai (0, requires key). Unset = auto.
GRAPHAGENT_MOCK_LLM=

# --- Isolation ---------------------------------------------------------
# auto (preferred: docker when daemon+image available, else local) | docker | local
GRAPHAGENT_ISOLATION=auto
GRAPHAGENT_DOCKER_IMAGE=graphagent-runner:latest
# Set to 0 to skip the automatic one-time runner image build.
GRAPHAGENT_DOCKER_BUILD=1

# --- Run budgets (defaults for new runs; overridable per run in the UI) -
GRAPHAGENT_MAX_ITERATIONS=3
GRAPHAGENT_TOOL_BUDGET=60
GRAPHAGENT_TOKEN_BUDGET=60000
GRAPHAGENT_TIMEOUT_SEC=600
GRAPHAGENT_STAGE_MAX_STEPS=14
GRAPHAGENT_TEST_TIMEOUT_SEC=180

# --- Storage -----------------------------------------------------------
# GRAPHAGENT_DATA_DIR=./data
# GRAPHAGENT_CORS=http://localhost:5173,http://127.0.0.1:5173
